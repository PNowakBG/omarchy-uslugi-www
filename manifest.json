{
  "schemaVersion": 1,
  "id": "pablo.uslugi",
  "name": "Usługi WWW",
  "version": "1.0.0",
  "author": "pablo",
  "description": "Lokalne usługi WWW (docker i procesy): adresy i porty, klik otwiera w przeglądarce.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Usługi WWW",
    "description": "Nasłuchujące lokalne serwisy WWW z dockera i procesów; klik = otwórz w przeglądarce.",
    "category": "Development",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Odświeżanie (sekundy)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
